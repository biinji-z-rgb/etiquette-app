# Copie ce fichier en ".env" pour tester en local (ne JAMAIS committer le vrai .env)

PORT=3000
TZ=Europe/Paris

# --- Google Cloud (compte de service) ---
# Colle ici tout le contenu JSON du fichier de clé, sur UNE seule ligne.
GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...", "...": "..."}

# ID du Google Sheet partagé (dans l'URL : https://docs.google.com/spreadsheets/d/CET_ID/edit)
GOOGLE_SHEET_ID=

# --- Cloudinary (stockage gratuit des photos, sans carte bancaire) ---
# Crée un compte gratuit sur https://cloudinary.com puis récupère ces 3 valeurs
# sur ton Dashboard (page d'accueil après connexion).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
